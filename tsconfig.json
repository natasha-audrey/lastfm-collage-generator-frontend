{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "jest", "@testing-library/jest-dom"],
    "allowJs": true,
    "checkJs": true
  },
  "include": ["src", "vite.config.ts", "eslint.config.mjs", "jest.config.cjs"]
}
